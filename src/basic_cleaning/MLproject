name: basic_cleaning
conda_env: conda.yml

entry_points:
  main:
    parameters:

      dirty_artifact:
        description: Name of the input artifact to clean
        type: string

      clean_artifact:
        description: Name for the output artifact
        type: string

      artifact_type:
        description: Type of the output artifact
        type: string

      artifact_description:
        description: A brief description of the output artifact
        type: string

      filters:
        description: >
          JSON array of [column, min, max] triples to filter rows by, e.g.
          '[["price", 10, 350], ["minimum_nights", 1, 365]]'
        type: string
        default: "[]"

    command: >-
        python run.py
        --dirty_artifact {dirty_artifact}
        --clean_artifact {clean_artifact}
        --artifact_type {artifact_type}
        --artifact_description {artifact_description}
        --filters {filters}